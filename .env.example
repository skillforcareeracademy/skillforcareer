# ─────────────────────────────────────────────────────────────────────────────
# SkillForCareer LMS — Environment template. Copy to `.env` and fill in values.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV="development"
NEXT_PUBLIC_APP_NAME="SkillForCareer"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Database (TiDB Cloud Serverless, MySQL-compatible) ───────────────────────
# IMPORTANT: never point Prisma at TiDB's `sys` schema (P3004). Use a dedicated
# application database (default: `lms`). Create it with scripts/create-db.mjs.
DATABASE_URL="mysql://<user>:<password>@<host>:4000/lms"
# Same credentials, but the `test` schema — used only to create the `lms` db.
BOOTSTRAP_DATABASE_URL="mysql://<user>:<password>@<host>:4000/test"

# ── Auth / JWT (generate with: openssl rand -base64 48) ──────────────────────
JWT_ACCESS_SECRET="<random-secret>"
JWT_REFRESH_SECRET="<random-secret>"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="365d"

# ── Email OTP ────────────────────────────────────────────────────────────────
OTP_LENGTH="6"
OTP_EXPIRY_MINUTES="10"
OTP_MAX_ATTEMPTS="5"

# ── SMTP (Gmail: use a 16-char App Password, not the account password) ───────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="<your-gmail-address>"
SMTP_PASSWORD="<gmail-app-password>"
SMTP_FROM_NAME="SkillForCareer"
SMTP_FROM_EMAIL="<your-gmail-address>"

# ── SMS gateway (lead reminders) ─────────────────────────────────────────────
# Any provider that takes a plain HTTP request works — MSG91, Fast2SMS,
# Textlocal, Gupshup, a telco API. Leave SMS_API_URL empty to disable SMS; lead
# reminders then go out by email only. Placeholders you can use in the URL and
# the body template: {to} {text} {sender} {template} {key}
#
#   MSG91-style example:
#     SMS_API_URL="https://api.msg91.com/api/v2/sendsms"
#     SMS_API_BODY='{"sender":"{sender}","route":"4","country":"91","sms":[{"message":"{text}","to":["{to}"]}]}'
#
SMS_API_URL=""
SMS_API_METHOD="POST"
SMS_API_KEY=""
SMS_API_BODY=""
SMS_SENDER_ID=""          # 6-character DLT sender id, e.g. SFCACD
SMS_TEMPLATE_ID=""        # DLT template id, when the provider requires one

# ── AI assistance (optional) ─────────────────────────────────────────────────
# Used by Admin → Quizzes → "Generate from notes". Any endpoint that speaks the
# usual chat-completions shape works — OpenAI, Azure OpenAI, Groq, Together, or
# Ollama / llama.cpp running on the academy's own machine. Leave AI_API_URL
# empty and the platform drafts questions with its own built-in reader instead,
# so the feature works with nothing rented.
#
#   OpenAI-style example:
#     AI_API_URL="https://api.openai.com/v1/chat/completions"
#     AI_MODEL="gpt-4o-mini"
#
AI_API_URL=""
AI_API_KEY=""
AI_MODEL=""

# ── Event stream (signed, consumed by the separate CRM product) ─────────────
EVENT_SIGNING_SECRET="<random-hex-secret>"

# ── File storage (local now; S3-compatible later) ────────────────────────────
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage/uploads"

# ── Realtime / Video conferencing signaling ─────────────────────────────────
# The signaling server is a separate always-on process (`npm run signal`); it
# cannot run on Vercel, which has no long-lived WebSocket connections.
#
# On the Next.js app: where the browser should connect (https/wss in prod).
SIGNAL_URL="http://localhost:4001"
# On the signaling host: port to bind (hosts that inject PORT override this),
# plus the app origins allowed through the socket CORS check.
SIGNAL_PORT="4001"
ALLOWED_ORIGINS="http://localhost:3000"

# ── Live classes: STUN / TURN ────────────────────────────────────────────────
# Class video is peer-to-peer — the two browsers send media straight to each
# other and the signaling server only introduces them. That works on a friendly
# network. On mobile data, on college Wi-Fi and behind most office firewalls
# there is no direct route, and without a relay the call simply never connects.
# A TURN server is that relay, and it is the single most important setting here
# if people report "video is not working".
#
# Leave everything below empty and rooms fall back to public STUN: fine for a
# demo, unreliable for a real class on Indian mobile networks.
#
# Comma-separated; list UDP first, then TCP, then TLS on 443 — 443 is the port
# that gets out of the strictest networks.
TURN_URLS=""   # e.g. "turn:turn.skillforcareer.com:3478?transport=udp,turn:turn.skillforcareer.com:3478?transport=tcp,turns:turn.skillforcareer.com:5349?transport=tcp"
#
# Preferred: coturn with `use-auth-secret` + `static-auth-secret=<this value>`.
# The app then mints a credential per learner that expires by itself, so a
# leaked one is worthless and nobody can borrow the relay's bandwidth.
# Generate with: openssl rand -hex 32
TURN_SHARED_SECRET=""
#
# Or, for a TURN server with a fixed login, use these two instead. Never put
# these values in client code — the app only ever serves them from
# /api/live/ice to a signed-in user.
TURN_USERNAME=""
TURN_PASSWORD=""
#
# Override the STUN servers as well (optional). Empty = public STUN.
STUN_URLS=""
#
# How many people a room carries at full video. Mesh video costs every
# participant one upload per other participant, so past this many the room
# keeps audio for everyone but shows video only for the host and whoever is
# speaking, and says so on screen. 6–8 is the honest ceiling for a browser
# mesh; a bigger class needs an SFU.
NEXT_PUBLIC_LIVE_MESH_LIMIT="6"

# ── Payments (Razorpay) ──────────────────────────────────────────────────────
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Set this to the signing secret from the Razorpay dashboard webhook you point at
# /api/webhooks/razorpay. Online payments only auto-reconcile once it's set.
RAZORPAY_WEBHOOK_SECRET=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ── Scheduled jobs ───────────────────────────────────────────────────────────
# Bearer token the cron endpoints (/api/cron/payment-reminders and
# /api/cron/lead-reminders) check.
# Vercel Cron sends it automatically when set as a project env var.
CRON_SECRET=""

# ── Coding Practice (single sign-on) ─────────────────────────────────────────
# The "Coding Practice" link in the panels signs people straight in to the
# separate practice product. The secret must match that product's
# LMS_SSO_SECRET (generate with: openssl rand -base64 48). The URL is where it
# runs; Admin → Settings → Coding Practice can override it.
CODING_PRACTICE_SSO_SECRET=""
CODING_PRACTICE_URL=""
