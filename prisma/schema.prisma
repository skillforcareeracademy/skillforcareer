  DEBIT
}

enum WithdrawalStatus {
  PENDING
  PAID
  REJECTED
}

enum ReferralStatus {
  PENDING
  QUALIFIED
  REWARDED
  EXPIRED
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  GRADED
  RESUBMIT_REQUESTED
