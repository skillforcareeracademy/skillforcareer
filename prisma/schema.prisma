enum CertificateType {
  COURSE_COMPLETION
  INTERNSHIP_COMPLETION
  APPRECIATION
  INTERNSHIP_APPRECIATION
}

enum MeetingStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

enum MeetingRole {
  HOST
  CO_HOST
  ATTENDEE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEFT_EARLY
}

enum NotificationType {
  SYSTEM
  COURSE
  PAYMENT
  LIVE_CLASS
  ASSIGNMENT
  QUIZ
  CERTIFICATE
  ANNOUNCEMENT
  DISCUSSION
}

enum NotificationChannel {
  IN_APP
  EMAIL
  WHATSAPP
}

/// Who a broadcast goes to. `ROLES`, `BATCHES`, `COURSES` and `USERS` read the
/// chosen ids out of `Broadcast.targetIds`; the rest need no ids.
///
/// Roles are the catch-all the academy asked for ("and more scenarios"): roles
/// live in the database and admins can invent new ones, so "all students",
/// "instructors only", "both", "sales agents" and anything created later are
/// all the same audience with a different pick — no new code each time.
/// What a thrown-away item used to be. Only things that can be put back
/// whole are listed here — a course or a batch drags half the database behind
/// it and is not something a bin can honestly promise to restore.
/// The kinds of term the academy keeps — the client's own list: "Root,
/// suffix, prefix, abbreviations, Diagnosis terms, procedure terms, HCPCS
/// terms, units, instruments."
enum TermKind {
  ROOT
  PREFIX
  SUFFIX
  ABBREVIATION
  DIAGNOSIS
  PROCEDURE
  HCPCS
  UNIT
  INSTRUMENT
}

enum TrashKind {
  QUIZ
  ASSIGNMENT
  STUDY_MATERIAL
  BATCH_NOTE
  NOTE
  BLOG_POST
}

enum BroadcastAudience {
  ROLES
  BATCHES
  COURSES
  USERS
  ALL_USERS
  PLACEMENT_PARTNERS
  HIRING_PARTNERS
  PLACEMENT_CANDIDATES
}

enum OtpPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
  LOGIN
}

enum OutboxStatus {
  PENDING
  SENT
  FAILED
}

// ══════════════════════════════════════════════════════════════════════════════
// AUTH & RBAC
// ══════════════════════════════════════════════════════════════════════════════

model User {
  id            String     @id @default(cuid())
  name          String
  email         String     @unique
  emailVerified DateTime?
  passwordHash  String?
  avatarUrl     String?
  phone         String?
  headline      String?
  bio           String?    @db.Text
  status        UserStatus @default(PENDING)
  timezone      String     @default("Asia/Kolkata")
  locale        String     @default("en")

  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onUpdate: NoAction)

  /// Birthday. The academy sends wishes and a referral voucher on the day.
  dateOfBirth           DateTime?
  /// When the last birthday greeting went out — one a year, however often the
  /// morning sweep runs.
  lastBirthdayWishAt    DateTime?
  /// The birthday voucher's own code: a different one from the standing
  /// referral code, worth more, and good only for as long as the academy says.
  /// Not a unique index: TiDB won't take a new one without a destructive
  /// push, so the generator checks the code isn't already out (see
  /// `referral-service.issueBirthdayCode`).
  birthdayCode          String?
  birthdayCodeExpiresAt DateTime?

  // Refer-and-earn
  referralCode String? @unique

  // Per-user settings (notification toggles, etc.) — JSON blob, merged with defaults in code.
  preferences Json?

  /// The internship this learner served at the academy. Kept on the learner
  /// rather than on the certificate so admissions can answer "is their
  /// internship over yet?" before any award is printed — and so the internship
  /// certificate can fill its own dates in from here.
  internshipStartAt DateTime?
  internshipEndAt   DateTime?

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  coursesAuthored      Course[]               @relation("CourseInstructor")
  batchesLed           Batch[]                @relation("BatchInstructor")
  enrollments          Enrollment[]
  lessonProgress       LessonProgress[]
  notes                Note[]
  bookmarks            Bookmark[]
  reviews              Review[]
  discussions          Discussion[]
  payments             Payment[]
  wallet               Wallet?
  referralsMade        Referral[]             @relation("Referrer")
  referralsReceived    Referral[]             @relation("Referee")
  questionReviews      QuestionReview[]       @relation("QuestionReviewStudent")
  questionReviewsFixed QuestionReview[]       @relation("QuestionReviewResolver")
  assignmentsCreated   Assignment[]           @relation("AssignmentCreator")
  submissions          AssignmentSubmission[] @relation("SubmissionStudent")
  gradedSubmissions    AssignmentSubmission[] @relation("SubmissionGrader")
  quizzesCreated       Quiz[]                 @relation("QuizCreator")
  quizAttempts         QuizAttempt[]
  certificates         Certificate[]
  notifications        Notification[]
  activityLogs         ActivityLog[]
  refreshTokens        RefreshToken[]
  otpTokens            OtpToken[]
  meetingsHosted       Meeting[]              @relation("MeetingHost")
  meetingParts         MeetingParticipant[]
  attendance           Attendance[]
  liveChatMessages     LiveChatMessage[]
  leadsAssigned        Lead[]                 @relation("LeadAssignee")
  leadFollowUps        LeadFollowUp[]         @relation("LeadFollowUpAuthor")
  leadDocuments        LeadDocument[]         @relation("LeadDocumentUploader")
  leadContacts         LeadContact[]          @relation("LeadContactAgent")
  leadsConvertedFrom   Lead[]                 @relation("LeadConvertedStudent")
  webinarsHosted       Webinar[]              @relation("WebinarHost")
  webinarsAttended     WebinarRegistration[]  @relation("WebinarAttendee")
  assignmentsSet       AssignmentStudent[]    @relation("AssignmentAssignee")
  blogPosts            BlogPost[]             @relation("BlogAuthor")
  mediaUploads         MediaFile[]            @relation("MediaUploader")
  quizzesSet           QuizStudent[]          @relation("QuizAssignee")
  lessonAccess         LessonAccess[]         @relation("LessonAccessUser")
  chatMessages         ChatMessage[]          @relation("ChatMessageUser")
  recordingAccess      RecordingAccess[]      @relation("RecordingAccessUser")
  recordingViews       RecordingView[]        @relation("RecordingViewUser")
  recordingDevices     RecordingDevice[]      @relation("RecordingDeviceUser")
  extraRoles           UserRole[]             @relation("UserExtraRoles")
  extraPermissions     UserPermission[]
  batchesAssisted      BatchInstructor[]      @relation("BatchAssociate")
  batchNotes           BatchNote[]            @relation("BatchNoteAuthor")
  noteReads            NoteRead[]             @relation("NoteReader")
  detail               StudentDetail?
  materialsAuthored    StudyMaterial[]        @relation("MaterialAuthor")
  materialsSet         StudyMaterialStudent[] @relation("MaterialAssignee")
  materialReads        MaterialRead[]         @relation("MaterialReader")
  materialHighlights   MaterialHighlight[]    @relation("MaterialHighlighter")
  withdrawals          WalletWithdrawal[]     @relation("WalletWithdrawalUser")
  curriculums          Curriculum[]           @relation("CurriculumAuthor")
  curriculumChanges    CurriculumChange[]     @relation("CurriculumChangeAuthor")
  withdrawalsHandled   WalletWithdrawal[]     @relation("WalletWithdrawalAdmin")
  broadcastsSent       Broadcast[]            @relation("BroadcastSender")
  assignmentAttempts   AssignmentAttempt[]    @relation("AssignmentAttemptStudent")
  terms                Term[]                 @relation("TermAuthor")
  boardSlides          BoardSlide[]           @relation("BoardAuthor")
  termBookmarks        TermBookmark[]         @relation("TermBookmarkUser")
  trashed              TrashItem[]            @relation("TrashOwner")

  @@index([roleId])
  @@index([status])
}

/// Everything the academy needs about a learner beyond a name and an email.
///
/// "Student ka detail profile hona chahiye — address, WhatsApp, Aadhaar aur ID
/// upload, qualification, CV, job status, package, placement preference." Kept
/// in its own table rather than bolted onto `User`, because only learners fill
/// it in, it is long, and admissions reads it as one form.
///
/// Once the learner presses submit, the fields admissions verifies — the
/// documents above all — are read-only to them. Staff can still change
/// anything, and `updatedByStaffAt` records that they did.
model StudentDetail {
  id     String @id @default(cuid())
  userId String @unique

  // ── Reaching them ─────────────────────────────────────────────────────────
  whatsapp       String?
  alternatePhone String?
  addressLine    String? @db.Text
  city           String?
  state          String?
  pincode        String?
  country        String  @default("India")

  // ── Who they are, on paper ────────────────────────────────────────────────
  gender        String?
  fatherName    String?
  guardianPhone String?
  /// Stored as given; the panel shows only the last four digits to staff who
  /// don't hold `users:manage`.
  aadhaarNumber String?
  aadhaarUrl    String?
  /// PAN / passport / driving licence — whatever they uploaded instead.
  idProofType   String?
  idProofNumber String?
  idProofUrl    String?

  // ── What they have studied ────────────────────────────────────────────────
  highestQualification String?
  specialization       String?
  collegeName          String?
  passingYear          Int?
  marksPercent         String?
  cvUrl                String?
  cvName               String?

  // ── Work, and what they want next ─────────────────────────────────────────
  /// FRESHER / WORKING / LOOKING / STUDYING — free text so the academy can add
  /// its own without a migration.
  jobStatus          String?
  currentCompany     String?
  currentRole        String?
  experienceYears    String?
  currentPackage     Decimal? @db.Decimal(10, 2)
  expectedPackage    Decimal? @db.Decimal(10, 2)
  preferredLocations String?
  /// ONSITE / REMOTE / HYBRID.
  preferredMode      String?
  willingToRelocate  Boolean  @default(false)
  openToPlacement    Boolean  @default(true)

  /// When the learner submitted the form. Null means still a draft, and
  /// everything stays editable.
  submittedAt      DateTime?
  /// The last time staff changed a submitted form.
  updatedByStaffAt DateTime?
  /// Which lead this was filled in from, if admissions converted one.
  fromLeadId       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

// ══════════════════════════════════════════════════════════════════════════════
// STUDY MATERIAL — the reading a course sets, and what a learner does with it
// ══════════════════════════════════════════════════════════════════════════════

/// A folder for study material, one level deep like the quiz grouping: a
/// category and its sub-categories, so a learner sees "Anatomy → Upper limb"
/// rather than one long list.
model MaterialCategory {
  id       String  @id @default(cuid())
  name     String
  parentId String?
  order    Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// NoAction, not Cascade: Prisma forbids a cascading self-relation. Deleting
  /// a category takes its sub-categories with it in the service.
  parent      MaterialCategory?  @relation("MaterialCategoryTree", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children    MaterialCategory[] @relation("MaterialCategoryTree")
  materials   StudyMaterial[]    @relation("MaterialInCategory")
  subMaterials StudyMaterial[]   @relation("MaterialInSubCategory")

  @@index([parentId])
}

/// One piece of reading: a document, a spreadsheet, a PDF, or text written
/// straight into the panel.
///
/// `number` is permanent — Material 1 stays Material 1 however the list is
/// rearranged — and `sequence` is the order the academy wants it worked
/// through, exactly as quizzes do it.
model StudyMaterial {
  id          String  @id @default(cuid())
  title       String
  description String? @db.Text
  courseId    String?

  categoryId    String?
  subCategoryId String?

  /// Permanent identity, and the rearrangeable order.
  number   Int @default(0)
  sequence Int @default(0)

  /// The file, if it is one.
  fileUrl  String?
  fileName String?
  mimeType String?
  /// Text written in the panel instead of, or alongside, a file. This is what a
  /// learner can highlight.
  body     String? @db.Text

  /// "Download off karne ka option" — reading stays possible, saving a copy
  /// does not.
  downloadsEnabled Boolean @default(true)
  isPublished      Boolean @default(false)

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category    MaterialCategory?        @relation("MaterialInCategory", fields: [categoryId], references: [id], onUpdate: NoAction)
  subCategory MaterialCategory?        @relation("MaterialInSubCategory", fields: [subCategoryId], references: [id], onUpdate: NoAction)
  course      Course?                  @relation(fields: [courseId], references: [id], onUpdate: NoAction)
  createdBy   User                     @relation("MaterialAuthor", fields: [createdById], references: [id], onUpdate: NoAction)
  batches     StudyMaterialBatch[]
  courses     StudyMaterialCourse[]
  students    StudyMaterialStudent[]
  assets      MaterialAsset[]
  reads       MaterialRead[]
  highlights  MaterialHighlight[]
  quizSources QuizSource[]

  @@index([courseId])
  @@index([categoryId])
  @@index([subCategoryId])
  @@index([createdById])
  @@index([isPublished])
}

/// One of the courses this material is set for.
///
/// "Multiple courses, batches can be assigned in study material also like
/// quiz." The single `courseId` column stays as the primary course — it is what
/// the numbering and the old rows are filed under — and this carries the rest.
model StudyMaterialCourse {
  id         String @id @default(cuid())
  materialId String
  courseId   String

  createdAt DateTime @default(now())

  material StudyMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  course   Course        @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([materialId, courseId])
  @@index([courseId])
}

/// What a learner is given a piece of reading. More than one file, images, a
/// video, or a link out — "multiple files, images and all can be uploaded here.
/// videos here. also provide an option to add link".
enum MaterialAssetKind {
  FILE
  IMAGE
  VIDEO
  LINK
}

model MaterialAsset {
  id         String            @id @default(cuid())
  materialId String
  kind       MaterialAssetKind @default(FILE)
  url        String            @db.Text
  name       String?
  mimeType   String?
  /// Bytes, when it was uploaded rather than linked.
  sizeBytes  Int?
  order      Int               @default(0)

  createdAt DateTime @default(now())

  material StudyMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([materialId])
}

/// Set for a cohort. No batch and no named learner means everyone on the
/// course — the same audience rule quizzes and assignments follow.
model StudyMaterialBatch {
  id         String @id @default(cuid())
  materialId String
  batchId    String

  createdAt DateTime @default(now())

  material StudyMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  batch    Batch         @relation(fields: [batchId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([materialId, batchId])
  @@index([batchId])
}

/// Set for one learner by name.
model StudyMaterialStudent {
  id         String @id @default(cuid())
  materialId String
  userId     String

  createdAt DateTime @default(now())

  material StudyMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user     User          @relation("MaterialAssignee", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([materialId, userId])
  @@index([userId])
}

/// "Kisne kitni baar padha" — one row per learner per piece, added to as they
/// read. Same shape as `NoteRead`, and written the same way.
model MaterialRead {
  id          String   @id @default(cuid())
  materialId  String
  userId      String
  opens       Int      @default(1)
  seconds     Int      @default(0)
  /// Set when the learner has downloaded it, for the download cap.
  downloads   Int      @default(0)
  firstReadAt DateTime @default(now())
  lastReadAt  DateTime @default(now())

  material StudyMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user     User          @relation("MaterialReader", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([materialId, userId])
  @@index([userId])
}

/// A learner's own mark on the reading: the passage they picked out and,
/// optionally, what they thought about it. Theirs alone — nobody else sees it.
model MaterialHighlight {
  id         String  @id @default(cuid())
  materialId String
  userId     String
  /// The exact text they selected, so it can be found again after an edit.
  quote      String  @db.Text
  /// Where in the body it started, to place it when the quote repeats.
  startOffset Int    @default(0)
  note       String? @db.Text
  /// yellow / green / blue / pink — the pen they used.
  color      String  @default("yellow")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  material StudyMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user     User          @relation("MaterialHighlighter", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([materialId, userId])
  @@index([userId])
}

// ══════════════════════════════════════════════════════════════════════════════
// GROUPS — one filing system for every library the academy keeps
// ══════════════════════════════════════════════════════════════════════════════

/// Which library a group belongs to. Each keeps its own tree, so "Anatomy"
/// under quizzes is not the same folder as "Anatomy" under study material.
enum GroupKind {
  QUIZ
  MATERIAL
  CURRICULUM
  ASSIGNMENT
  BATCH
  CERTIFICATE
  DISCUSSION
}

/// A folder, nested as deep as the academy wants.
///
/// "Can you provide option to create grouping & multiple sub grouping as per my
/// need — in Quiz, study material, curriculum, assignments, batches,
/// certificates, discussion." One tree serves all seven: the alternative was
/// seven near-identical category tables, each with its own two-level limit.
///
/// Depth is not capped. A cycle is prevented in the service, which walks the
/// ancestors before it reparents anything.
model ContentGroup {
  id       String    @id @default(cuid())
  kind     GroupKind
  name     String
  parentId String?
  /// Where it sits among its siblings.
  order    Int       @default(0)
  /// Free text the academy can put on a folder.
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// NoAction, not Cascade: Prisma forbids a cascading self-relation. The
  /// service deletes a subtree from the leaves up.
  parent      ContentGroup?      @relation("ContentGroupTree", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children    ContentGroup[]     @relation("ContentGroupTree")
  items       ContentGroupItem[]
  batchAccess BatchGroupAccess[]

  @@index([kind])
  @@index([parentId])
}

/// One row filed in one folder. An item may sit in as many folders as suits —
/// "multiple groups can be selected in quiz, curriculum, study material,
/// assignment".
///
/// `itemId` is deliberately not a foreign key: this one table holds quizzes,
/// material, assignments, curriculums, batches, certificates and discussions,
/// and no column can point at seven tables. Orphans are swept when the owning
/// row is deleted, by the service that deletes it.
model ContentGroupItem {
  id      String    @id @default(cuid())
  groupId String
  itemId  String
  kind    GroupKind

  createdAt DateTime @default(now())

  group ContentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([groupId, itemId])
  @@index([itemId])
  @@index([kind])
}

/// A whole folder handed to a cohort.
///
/// "Ek group me 5 quiz hain to mai pure group ka access batch me de du and wo
/// saare group and uski quizzes usko assign ho jaayein." Given a folder, the
/// batch gets everything in it — and everything in the folders beneath it —
/// including anything added later, which is the point of assigning the folder
/// rather than its contents.
model BatchGroupAccess {
  id      String @id @default(cuid())
  batchId String
  groupId String

  createdAt DateTime @default(now())

  batch Batch        @relation(fields: [batchId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  group ContentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([batchId, groupId])
  @@index([groupId])
}

/// A stage on the academy's own pipeline.
///
/// "Provide me an option to add, change and delete lead stages and status
/// dynamically." The nine that shipped are seeded here and can be renamed,
/// reordered or switched off; anything new sits beside them. `systemStage` is
/// what it behaves like underneath — which is how a renamed pipeline keeps its
/// reports, its conversion counting and its automation.
model LeadStageOption {
  id          String    @id @default(cuid())
  /// Written onto `Lead.stageKey`. Stable across renames.
  key         String
  name        String
  order       Int       @default(0)
  /// A tint for the board column.
  color       String?
  isActive    Boolean   @default(true)
  /// Where a new enquiry starts.
  isDefault   Boolean   @default(false)
  systemStage LeadStage @default(FRESH_LEAD)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  statuses LeadStatusOption[]

  @@index([key])
  @@index([isActive])
}

/// A sub-status under a stage — "Fees pending", "Demo booked", and whatever
/// else the academy decides it needs. Global when no stage is named.
model LeadStatusOption {
  id            String  @id @default(cuid())
  name          String
  order         Int     @default(0)
  isActive      Boolean @default(true)
  stageOptionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stage LeadStageOption? @relation(fields: [stageOptionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([stageOptionId])
}

model Role {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique // SUPER_ADMIN, ADMIN, INSTRUCTOR, STUDENT, or custom
  description String?
  isSystem    Boolean @default(false) // built-in roles cannot be deleted

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  permissions RolePermission[]
  extraUsers  UserRole[]
}

model Permission {
  id          String  @id @default(cuid())
  key         String  @unique // resource:action, e.g. "courses:create"
  group       String // grouping for the admin UI, e.g. "Catalog"
  description String?

  createdAt DateTime @default(now())

  roles RolePermission[]
  users UserPermission[]
}

/// One permission granted to, or taken from, a single person.
///
/// "Individual user based permissions bhi dene ka option hona chahiye. Jaise
/// shagun sales agent hai to mai sabhi sales agent ko lead upload karne ka nhi
/// de skta. Sirf shagun ko dena hai." Roles answer "what may a sales agent do";
/// this answers "what may *this* sales agent do", without inventing a role for
/// one person.
///
/// `allow = false` is a revoke, and it wins over the role: it is the only way
/// to take something back from one person while their colleagues keep it.
model UserPermission {
  id           String  @id @default(cuid())
  userId       String
  permissionId String
  allow        Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, permissionId])
  @@index([userId])
  @@index([permissionId])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
  @@index([expiresAt])
}

model OtpToken {
  id         String     @id @default(cuid())
  userId     String?
  email      String
  codeHash   String
  purpose    OtpPurpose
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
  @@index([email, purpose])
  @@index([expiresAt])
}

// ══════════════════════════════════════════════════════════════════════════════
// CATALOG — categories, courses, batches, chapters, lessons, media
// ══════════════════════════════════════════════════════════════════════════════

model Category {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  icon        String?
  order       Int     @default(0)
  isActive    Boolean @default(true)

  // Self-relation → sub-categories
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children Category[] @relation("CategoryTree")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courses   Course[]
  blogPosts BlogPost[]

  @@index([parentId])
}

model Course {
  id            String       @id @default(cuid())
  title         String
  slug          String       @unique
  subtitle      String?
  description   String?      @db.Text
  thumbnailUrl  String?
  promoVideoUrl String?
  level         CourseLevel  @default(ALL_LEVELS)
  deliveryMode  DeliveryMode @default(SELF_PACED)
  status        CourseStatus @default(DRAFT)
  language      String       @default("en")

  pricingType   PricingType @default(PAID)
  price         Decimal     @default(0) @db.Decimal(10, 2)
  discountPrice Decimal?    @db.Decimal(10, 2)
  currency      String      @default("INR")

  requirements Json? // string[]
  objectives   Json? // string[]
  tags         Json? // string[]

  durationMinutes Int     @default(0)
  isFeatured      Boolean @default(false)

  /// The academy's own numbering, and what it abbreviates to.
  ///
  /// "Format is SFC + MC + course code which is unique for every course."
  /// `courseNo` is that code — 001, 002, … — handed out once and never reused;
  /// `abbreviation` is the first letter of each word of the name (Medical
  /// Coding → MC), generated on creation and editable, since two courses can
  /// abbreviate alike and only a person can judge the better short form.
  courseNo     Int     @default(0)
  abbreviation String?

  // Denormalised aggregates for fast catalog rendering
  ratingAvg       Float @default(0)
  ratingCount     Int   @default(0)
  enrollmentCount Int   @default(0)

  categoryId   String
  instructorId String

  category   Category @relation(fields: [categoryId], references: [id], onUpdate: NoAction)
  instructor User     @relation("CourseInstructor", fields: [instructorId], references: [id], onUpdate: NoAction)

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  chapters          Chapter[]
  batches           Batch[]
  enrollments       Enrollment[]
  reviews           Review[]
  discussions       Discussion[]
  assignments       Assignment[]
  quizzes           Quiz[]
  studyMaterials    StudyMaterial[]
  materialCourses   StudyMaterialCourse[]
  attachments       Attachment[]
  certificates      Certificate[]
  meetings          Meeting[]
  payments          Payment[]
  coupons           Coupon[]
  leads             Lead[]
  curriculumCourses CurriculumCourse[]
  boardSlides BoardSlide[]

  @@index([categoryId])
  @@index([instructorId])
  @@index([status])
  @@index([isFeatured])
}

model Batch {
  id            String      @id @default(cuid())
  courseId      String
  instructorId  String?
  name          String
  code          String      @unique
  /// The academy's batch ID — SFCMC001005, and the same forever.
  ///
  /// Frozen as a string rather than rebuilt from the course each time, because
  /// renaming a course must not renumber the certificates already printed.
  /// Not a unique index: TiDB won't take a new one without a destructive push,
  /// so uniqueness is enforced where it is generated.
  batchId       String?
  /// This batch's number within its course — 001, 002, … — permanent.
  batchNo       Int         @default(0)
  /// The order the academy wants its batches listed in. Rearrangeable, unlike
  /// `batchNo`.
  sequence      Int         @default(0)
  status        BatchStatus @default(UPCOMING)
  capacity      Int?
  enrolledCount Int         @default(0)
  startDate     DateTime?
  endDate       DateTime?
  schedule      Json? // recurring session config

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course            Course            @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  instructor        User?             @relation("BatchInstructor", fields: [instructorId], references: [id], onUpdate: NoAction)
  enrollments       Enrollment[]
  meetings          Meeting[]
  attendance        Attendance[]
  assignments       AssignmentBatch[]
  quizzes           QuizBatch[]
  studyMaterials    StudyMaterialBatch[]
  lessonAccess      LessonAccess[]
  recordingAccess   RecordingAccess[]
  associates        BatchInstructor[]
  notes             BatchNote[]
  curriculumBatches CurriculumBatch[]
  groupAccess       BatchGroupAccess[]
  boardSlides BoardSlide[]

  @@index([courseId])
  @@index([instructorId])
  @@index([status])
  @@index([batchId])
}

model Chapter {
  id          String  @id @default(cuid())
  courseId    String
  title       String
  description String?
  order       Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  lessons Lesson[]

  @@index([courseId])
}

model Lesson {
  id              String     @id @default(cuid())
  chapterId       String
  title           String
  type            LessonType @default(VIDEO)
  order           Int        @default(0)
  isPreview       Boolean    @default(false)
  durationSeconds Int        @default(0)
  content         String?    @db.Text

  /// Release control — "students ko saare lessons ek saath nhi denge".
  /// IMMEDIATE (the shipped behaviour) opens the lesson to anyone enrolled;
  /// the other three narrow that by date, by days-since-enrolment, or to the
  /// cohorts and individuals listed in `access`.
  releaseMode LessonRelease @default(IMMEDIATE)
  releaseAt   DateTime?
  dripDays    Int?

  /// Watch/download caps, per learner. Null falls back to the platform default
  /// in Admin → Settings → Learning; 0 there too means unlimited.
  viewLimit        Int?
  downloadLimit    Int? // rich text for ARTICLE lessons
  /// Off means the material can't be downloaded at all — the academy's "I can
  /// not control if I want anyone to download any video or not". A limit of 0
  /// still means unlimited; this is the switch that says no.
  downloadsEnabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chapter     Chapter          @relation(fields: [chapterId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  video       Video?
  attachments Attachment[]
  quiz        Quiz?
  assignment  Assignment?
  progress    LessonProgress[]
  notes       Note[]
  quizSources QuizSource[]
  bookmarks   Bookmark[]
  discussions Discussion[]
  access      LessonAccess[]

  @@index([chapterId])
}

/// Who a MANUAL-release lesson is open to. Exactly one of `batchId` / `userId`
/// is set on a row. Deliberately no unique index: the service replaces the
/// whole set on every save (deleteMany + createMany), so duplicates can't
/// arise, and `db push` refuses to add a unique constraint without a
/// data-loss flag it is never given here.
model LessonAccess {
  id       String  @id @default(cuid())
  lessonId String
  batchId  String?
  userId   String?

  createdAt DateTime @default(now())

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  batch  Batch? @relation(fields: [batchId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user   User?  @relation("LessonAccessUser", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([lessonId])
  @@index([batchId])
  @@index([userId])
}

model Video {
  id              String  @id @default(cuid())
  lessonId        String  @unique
  url             String
  provider        String  @default("local") // local | s3 | mux | youtube
  durationSeconds Int     @default(0)
  sizeBytes       BigInt?
  resolution      String?
  captionsUrl     String?
  thumbnailUrl    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model Attachment {
  id        String         @id @default(cuid())
  name      String
  url       String
  type      AttachmentType @default(PDF)
  mimeType  String?
  sizeBytes BigInt?

  lessonId String?
  courseId String?

  createdAt DateTime @default(now())

  lesson Lesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  course Course? @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([lessonId])
  @@index([courseId])
}

// ══════════════════════════════════════════════════════════════════════════════
// LEARNING — enrollments, progress, notes, bookmarks, reviews, discussions
// ══════════════════════════════════════════════════════════════════════════════

model Enrollment {
  id              String           @id @default(cuid())
  userId          String
  courseId        String
  batchId         String?
  status          EnrollmentStatus @default(ACTIVE)
  source          EnrollmentSource @default(PURCHASE)
  progressPercent Float            @default(0)
  enrolledAt      DateTime         @default(now())
  completedAt     DateTime?
  expiresAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  course         Course           @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  batch          Batch?           @relation(fields: [batchId], references: [id], onUpdate: NoAction)
  lessonProgress LessonProgress[]
  certificate    Certificate?
  payments       Payment[]

  @@unique([userId, courseId])
  @@index([courseId])
  @@index([batchId])
  @@index([status])
}

model LessonProgress {
  id                  String         @id @default(cuid())
  userId              String
  lessonId            String
  enrollmentId        String?
  status              ProgressStatus @default(NOT_STARTED)
  watchedSeconds      Int            @default(0)
  lastPositionSeconds Int            @default(0) // video resume point
  completed           Boolean        @default(false)
  completedAt         DateTime?

  /// How many times this learner has opened the lesson and downloaded its
  /// material — what `Lesson.viewLimit` / `downloadLimit` are measured against.
  viewCount     Int @default(0)
  downloadCount Int @default(0)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  lesson     Lesson      @relation(fields: [lessonId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  enrollment Enrollment? @relation(fields: [enrollmentId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, lessonId])
  @@index([lessonId])
  @@index([enrollmentId])
}

/// A learner's own note. It hangs off whatever they were working through —
/// exactly one of `lessonId` or `quizId` is set.
model Note {
  id               String  @id @default(cuid())
  userId           String
  lessonId         String?
  quizId           String?
  timestampSeconds Int     @default(0)
  content          String  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  lesson Lesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  quiz   Quiz?   @relation(fields: [quizId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
  @@index([lessonId])
  @@index([quizId])
}

/// A place a learner wants to come back to — a moment in a lesson, or a whole
/// quiz saved for revision. Exactly one of `lessonId` or `quizId` is set.
model Bookmark {
  id               String  @id @default(cuid())
  userId           String
  lessonId         String?
  quizId           String?
  timestampSeconds Int     @default(0)
  label            String?

  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  lesson Lesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  quiz   Quiz?   @relation(fields: [quizId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
  @@index([lessonId])
  @@index([quizId])
}

model Review {
  id         String  @id @default(cuid())
  userId     String
  courseId   String
  rating     Int // 1..5
  comment    String? @db.Text
  isApproved Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, courseId])
  @@index([courseId])
}

model Discussion {
  id         String  @id @default(cuid())
  userId     String
  courseId   String?
  lessonId   String?
  parentId   String? // self-relation for threaded replies
  title      String?
  body       String  @db.Text
  isPinned   Boolean @default(false)
  isResolved Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  course  Course?      @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  lesson  Lesson?      @relation(fields: [lessonId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  parent  Discussion?  @relation("DiscussionThread", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies Discussion[] @relation("DiscussionThread")

  @@index([userId])
  @@index([courseId])
  @@index([lessonId])
  @@index([parentId])
}

// ══════════════════════════════════════════════════════════════════════════════
// ASSESSMENTS — assignments & quizzes
// ══════════════════════════════════════════════════════════════════════════════

model Assignment {
  id           String         @id @default(cuid())
  courseId     String?
  lessonId     String?        @unique
  createdById  String
  title        String
  description  String?        @db.Text
  instructions String?        @db.Text
  type         AssignmentType @default(FILE)
  gradingMode  GradingMode    @default(MANUAL)
  /// Permanent number, one run across the academy, never reused — and the
  /// rearrangeable order within the course. Same pair the quizzes carry.
  assignmentNo Int            @default(0)
  sequence     Int            @default(0)
  maxScore     Int            @default(100)
  /// True once someone types the total themselves. A paper with questions
  /// normally keeps `maxScore` equal to their points; this stops that sync so
  /// an admin can mark a 50-question paper out of 100 ("score automatic le rha
  /// hai, manual option hona chahiye edit krne ka").
  maxScoreManual Boolean      @default(false)
  dueDate      DateTime?
  allowLate    Boolean        @default(false)

  /// Hidden from learners until this moment. Null = visible as soon as it is
  /// set for them, which is how every assignment behaved before release control.
  releaseAt   DateTime?
  /// How many times a learner may submit. 0 = unlimited (the shipped behaviour).
  maxAttempts Int       @default(0)
  /// Whether a learner may stop part-way and come back to it. Off keeps the
  /// old behaviour, where leaving the page loses the answers.
  allowPause  Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course      Course?                @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  lesson      Lesson?                @relation(fields: [lessonId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  createdBy   User                   @relation("AssignmentCreator", fields: [createdById], references: [id], onUpdate: NoAction)
  submissions AssignmentSubmission[]
  questions   AssignmentQuestion[]
  attemptLog  AssignmentAttempt[]
  batches     AssignmentBatch[]
  students    AssignmentStudent[]

  @@index([courseId])
  @@index([createdById])
}

/// Which cohorts an assignment is set for. No rows = everyone on the course.
model AssignmentBatch {
  id           String @id @default(cuid())
  assignmentId String
  batchId      String

  createdAt DateTime @default(now())

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  batch      Batch      @relation(fields: [batchId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([assignmentId, batchId])
  @@index([batchId])
}

/// Individual learners added on top of the chosen batches.
model AssignmentStudent {
  id           String @id @default(cuid())
  assignmentId String
  userId       String

  createdAt DateTime @default(now())

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user       User       @relation("AssignmentAssignee", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([assignmentId, userId])
  @@index([userId])
}

/// A question on an MCQ / Q&A assignment — the quiz question model, kept
/// separate so assignment marking and quiz attempts can evolve apart.
/// A record of one submission, kept so every attempt can be looked back at.
///
/// `AssignmentSubmission` holds one row per learner and overwrites it on each
/// resubmission — that row is what grading reads, and changing it would mean
/// reworking marking. So each submission also writes a snapshot here. Nothing
/// reads this but the history view, which is exactly the point: the live row
/// keeps its meaning and the learner still gets "the result of every attempt
/// they take even after later".
model AssignmentAttempt {
  id           String   @id @default(cuid())
  assignmentId String
  studentId    String
  attemptNo    Int
  /// The answers as sent, in the same shape the submission stores them.
  answers      Json?
  autoScore    Int?
  score        Int?
  maxScore     Int      @default(0)
  /// Whether it still needed a person when it landed.
  needsMarking Boolean  @default(false)
  submittedAt  DateTime @default(now())

  createdAt DateTime @default(now())

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  student    User       @relation("AssignmentAttemptStudent", fields: [studentId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([assignmentId, studentId])
  @@index([submittedAt])
}

model AssignmentQuestion {
  id            String       @id @default(cuid())
  assignmentId  String
  type          QuestionType @default(SINGLE_CHOICE)
  text          String       @db.Text
  points        Int          @default(1)
  order         Int          @default(0)
  /// The model answer for written questions — shown to the grader, never the learner.
  correctAnswer String?      @db.Text
  explanation   String?      @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignment Assignment                 @relation(fields: [assignmentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  options    AssignmentQuestionOption[]

  @@index([assignmentId])
}

model AssignmentQuestionOption {
  id         String  @id @default(cuid())
  questionId String
  text       String  @db.Text
  isCorrect  Boolean @default(false)
  order      Int     @default(0)

  question AssignmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([questionId])
}

model AssignmentSubmission {
  id           String           @id @default(cuid())
  assignmentId String
  studentId    String
  attempt      Int              @default(1)
  /// How many times the learner has pressed submit on this row.
  ///
  /// `attempt` stays 1 and the row is overwritten — that is what grading reads
  /// — so the resubmission count needs somewhere of its own to live. This is
  /// what `Assignment.maxAttempts` is measured against.
  submitCount  Int              @default(1)
  status       SubmissionStatus @default(DRAFT)
  content      String?          @db.Text
  fileUrl      String?
  /// MCQ / Q&A answers: [{ questionId, optionIds?: string[], text?: string, points?: number }]
  answers      Json?
  /// What auto-marking awarded before any manual override.
  autoScore    Int?
  score        Int?
  feedback     String?          @db.Text
  gradedById   String?
  submittedAt  DateTime?
  gradedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  student    User       @relation("SubmissionStudent", fields: [studentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  gradedBy   User?      @relation("SubmissionGrader", fields: [gradedById], references: [id], onUpdate: NoAction)

  @@unique([assignmentId, studentId, attempt])
  @@index([studentId])
  @@index([gradedById])
  @@index([status])
}

model Quiz {
  id               String      @id @default(cuid())
  courseId         String?
  lessonId         String?     @unique
  createdById      String
  title            String
  description      String?     @db.Text
  timeLimitMinutes Int?
  passingScore     Int         @default(60) // percentage
  gradingMode      GradingMode @default(AUTO)
  maxAttempts      Int         @default(1)
  /// Whether a learner may stop part-way and come back to it. Off keeps the
  /// old behaviour, where leaving the page loses the answers.
  allowPause       Boolean     @default(false)
  shuffleQuestions Boolean     @default(false)
  showAnswers      Boolean     @default(true)
  isPublished      Boolean     @default(false)

  /// Marks the paper as soon as each question is answered, rather than only at
  /// the end. `showAnswers` is the other half of the pair: the whole answer key
  /// once the paper is submitted.
  showAnswerPerQuestion Boolean @default(false)

  /// Seconds allowed on each question, independent of `timeLimitMinutes` (the
  /// whole paper). Null = no per-question limit. With one set the paper is sat
  /// one question at a time; the academy can use either clock, or both.
  perQuestionSeconds Int?

  /// How hard the paper is, as the academy grades it.
  difficulty QuizDifficulty @default(EASY)

  /// The quiz's permanent number, handed out when it is created and never
  /// changed — "Quiz number can not be changed". It is how the academy refers
  /// to a paper between themselves; `sequence` below is the order learners work
  /// through, and that can be rearranged.
  quizNo Int @default(0)

  /// Grouping. A quiz sits in a category and, optionally, one of its
  /// sub-categories; `sequence` is its number inside that group and is what the
  /// list is ordered by, so "Quiz 1, Quiz 2, Quiz 3" is the academy's own order
  /// rather than whenever somebody last edited them.
  categoryId    String?
  subCategoryId String?
  sequence      Int     @default(0)

  /// Hidden from learners until this moment. Null = visible as soon as it is
  /// published and set for them.
  releaseAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course    Course?          @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  lesson    Lesson?          @relation(fields: [lessonId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  createdBy User             @relation("QuizCreator", fields: [createdById], references: [id], onUpdate: NoAction)
  questions Question[]
  reviews   QuestionReview[]
  attempts  QuizAttempt[]
  batches   QuizBatch[]
  students  QuizStudent[]
  notes     Note[]
  bookmarks Bookmark[]

  category    QuizCategory? @relation("QuizInCategory", fields: [categoryId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  subCategory QuizCategory? @relation("QuizInSubCategory", fields: [subCategoryId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  sources     QuizSource[]

  @@index([courseId])
  @@index([createdById])
  @@index([categoryId])
  @@index([subCategoryId])
}

/// A learner's "this question looks wrong" — raised from the quiz, answered by
/// an admin or the course's instructor.
///
/// The academy wanted it to work like a support ticket: the learner gets a
/// reference number (SFC2001, SFC2002, …) and a message the moment they raise
/// it, the teaching team gets an email and a dashboard message, and the reply
/// goes back to the learner the same two ways.
model QuestionReview {
  id           String               @id @default(cuid())
  /// The reference the learner is given, e.g. "SFC2001".
  ref          String
  quizId       String
  questionId   String
  studentId    String
  /// What the learner says is wrong. Optional — some just flag the question.
  message      String?              @db.Text
  status       QuestionReviewStatus @default(OPEN)
  /// What the admin or instructor wrote back.
  reply        String?              @db.Text
  resolvedById String?
  resolvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quiz       Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  student    User     @relation("QuestionReviewStudent", fields: [studentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  resolvedBy User?    @relation("QuestionReviewResolver", fields: [resolvedById], references: [id], onUpdate: NoAction)

  @@index([quizId])
  @@index([questionId])
  @@index([studentId])
  @@index([status])
  @@index([ref])
}

/// A quiz group, two levels deep: a row with no `parentId` is a category, one
/// with a parent is a sub-category of it. Kept apart from course categories on
/// purpose — the academy groups its papers by subject ("Medical Coding →
/// ICD-10"), which is not how it groups what it sells.
model QuizCategory {
  id       String  @id @default(cuid())
  name     String
  parentId String?
  order    Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// NoAction, not Cascade: Prisma forbids a cascading self-relation. Deleting
  /// a category takes its sub-categories with it in `quiz-category-service`.
  parent     QuizCategory?  @relation("QuizCategoryTree", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children   QuizCategory[] @relation("QuizCategoryTree")
  quizzes    Quiz[]         @relation("QuizInCategory")
  subQuizzes Quiz[]         @relation("QuizInSubCategory")

  @@index([parentId])
}

/// The notes a quiz was prepared from. Points at a batch note or a lesson —
/// or, when the staff pasted the notes straight in, at neither, and `text`
/// holds what they pasted. Learners see the source as revision material, and
/// the question generator reads it.
model QuizSource {
  id              String  @id @default(cuid())
  quizId          String
  batchNoteId     String?
  lessonId        String?
  /// Study material the paper was prepared from — the academy sets quizzes
  /// straight from what the batch was given to read.
  studyMaterialId String?
  title           String
  text            String? @db.Text

  createdAt DateTime @default(now())

  quiz          Quiz           @relation(fields: [quizId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  batchNote     BatchNote?     @relation(fields: [batchNoteId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  lesson        Lesson?        @relation(fields: [lessonId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  studyMaterial StudyMaterial? @relation(fields: [studyMaterialId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([quizId])
  @@index([batchNoteId])
  @@index([lessonId])
  @@index([studyMaterialId])
}

/// Which cohorts a quiz is set for. No rows = everyone on the course.
model QuizBatch {
  id      String @id @default(cuid())
  quizId  String
  batchId String

  createdAt DateTime @default(now())

  quiz  Quiz  @relation(fields: [quizId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  batch Batch @relation(fields: [batchId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([quizId, batchId])
  @@index([batchId])
}

/// Individual learners a quiz is set for, on top of the chosen batches — the
/// mirror of `AssignmentStudent`. No unique index for the same reason as
/// `LessonAccess`: the audience is replaced wholesale on every save.
model QuizStudent {
  id     String @id @default(cuid())
  quizId String
  userId String

  createdAt DateTime @default(now())

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user User @relation("QuizAssignee", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([quizId])
  @@index([userId])
}

model Question {
  id            String       @id @default(cuid())
  quizId        String
  type          QuestionType @default(SINGLE_CHOICE)
  text          String       @db.Text
  points        Int          @default(1)
  order         Int          @default(0)
  /// The model answer for SHORT_ANSWER questions — for the grader, and for export.
  correctAnswer String?      @db.Text
  explanation   String?      @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quiz      Quiz             @relation(fields: [quizId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  options   QuestionOption[]
  responses QuizResponse[]
  reviews   QuestionReview[]

  @@index([quizId])
}

model QuestionOption {
  id         String  @id @default(cuid())
  questionId String
  text       String  @db.Text
  isCorrect  Boolean @default(false)
  order      Int     @default(0)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([questionId])
}

model QuizAttempt {
  id               String            @id @default(cuid())
  quizId           String
  studentId        String
  attemptNo        Int               @default(1)
  status           QuizAttemptStatus @default(IN_PROGRESS)
  score            Int?
  maxScore         Int               @default(0)
  timeSpentSeconds Int               @default(0)
  startedAt        DateTime          @default(now())
  submittedAt      DateTime?
  gradedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quiz      Quiz           @relation(fields: [quizId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  student   User           @relation(fields: [studentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  responses QuizResponse[]

  @@unique([quizId, studentId, attemptNo])
  @@index([studentId])
  @@index([status])
}

model QuizResponse {
  id              String   @id @default(cuid())
  attemptId       String
  questionId      String
  selectedOptions Json? // string[] of QuestionOption ids
  answerText      String?  @db.Text
  isCorrect       Boolean?
  pointsAwarded   Int      @default(0)

  createdAt DateTime @default(now())

  attempt  QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  question Question    @relation(fields: [questionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([attemptId, questionId])
  @@index([questionId])
}

// ══════════════════════════════════════════════════════════════════════════════
// COMMERCE — payments, coupons, EMI, refunds, wallet, referrals
// ══════════════════════════════════════════════════════════════════════════════

model Payment {
  id                String          @id @default(cuid())
  userId            String
  courseId          String?
  enrollmentId      String?
  couponId          String?
  invoiceNumber     String          @unique
  amount            Decimal         @db.Decimal(10, 2)
  discountAmount    Decimal         @default(0) @db.Decimal(10, 2)
  taxAmount         Decimal         @default(0) @db.Decimal(10, 2)
  netAmount         Decimal         @db.Decimal(10, 2)
  currency          String          @default("INR")
  status            PaymentStatus   @default(PENDING)
  provider          PaymentProvider @default(RAZORPAY)
  type              PaymentType     @default(ONE_TIME)
  method            PaymentMethod?
  accountId         String?
  providerOrderId   String?
  providerPaymentId String?
  providerSignature String?
  metadata          Json?
  paidAt            DateTime?
  lastRemindedAt    DateTime?

  /// EMI pricing, set when `type = EMI`. Zero-cost plans spread the sticker
  /// price; interest plans add `interestPercent` on top, and `principalAmount`
  /// keeps the pre-interest figure so the learner's panel can show both.
  emiPlan         EmiPlan?
  interestPercent Decimal? @db.Decimal(5, 2)
  principalAmount Decimal? @db.Decimal(10, 2)

  /// Set when a counsellor collected this against a CRM lead, so admissions can
  /// trace a learner's first payment back to the enquiry that produced it.
  leadId        String?
  /// Unguessable token behind a shareable "pay now" URL. Present only on
  /// payments raised as a link; the page it opens needs no login, so the token
  /// is the only credential and it is scoped to this one payment.
  linkToken     String?   @unique
  linkExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User            @relation(fields: [userId], references: [id], onUpdate: NoAction)
  course       Course?         @relation(fields: [courseId], references: [id], onUpdate: NoAction)
  enrollment   Enrollment?     @relation(fields: [enrollmentId], references: [id], onUpdate: NoAction)
  coupon       Coupon?         @relation(fields: [couponId], references: [id], onUpdate: NoAction)
  account      PaymentAccount? @relation(fields: [accountId], references: [id], onUpdate: NoAction)
  lead         Lead?           @relation("LeadPayments", fields: [leadId], references: [id], onUpdate: NoAction)
  installments Installment[]
  refunds      Refund[]

  @@index([userId])
  @@index([courseId])
  @@index([enrollmentId])
  @@index([couponId])
  @@index([accountId])
  @@index([leadId])
  @@index([status])
}

model PaymentAccount {
  id            String             @id @default(cuid())
  name          String
  kind          PaymentAccountKind @default(UPI_QR)
  // UPI id / bank hint / free-text label for the account.
  identifier    String?
  // Razorpay accounts auto-reconcile via webhook; others are marked by hand.
  autoReconcile Boolean            @default(false)
  isActive      Boolean            @default(true)
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[]

  @@index([isActive])
}

model Coupon {
  id          String     @id @default(cuid())
  code        String     @unique
  type        CouponType @default(PERCENTAGE)
  value       Decimal    @db.Decimal(10, 2)
  maxDiscount Decimal?   @db.Decimal(10, 2)
  minAmount   Decimal?   @db.Decimal(10, 2)
  maxUses     Int?
  usedCount   Int        @default(0)
  courseId    String? // null → applies to all courses
  isActive    Boolean    @default(true)
  startsAt    DateTime?
  expiresAt   DateTime?

  /// Advertise this offer in the site-wide announcement bar. Off by default so
  /// one-off codes negotiated with a single learner never reach the homepage.
  showInBanner Boolean @default(false)
  /// Campaign line for that bar, e.g. "New year, new skills". Falls back to a
  /// sentence built from the discount when empty.
  bannerText   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course   Course?   @relation(fields: [courseId], references: [id], onUpdate: NoAction)
  payments Payment[]

  @@index([courseId])
}

model Installment {
  id             String            @id @default(cuid())
  paymentId      String
  installmentNo  Int
  amount         Decimal           @db.Decimal(10, 2)
  dueDate        DateTime
  status         InstallmentStatus @default(SCHEDULED)
  paidAt         DateTime?
  lastRemindedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([paymentId])
  @@index([status])
}

model Refund {
  id               String       @id @default(cuid())
  paymentId        String
  amount           Decimal      @db.Decimal(10, 2)
  reason           String?
  status           RefundStatus @default(REQUESTED)
  providerRefundId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([paymentId])
}

model Wallet {
  id       String  @id @default(cuid())
  userId   String  @unique
  balance  Decimal @default(0) @db.Decimal(10, 2)
  currency String  @default("INR")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  transactions WalletTransaction[]
}

model WalletTransaction {
  id          String        @id @default(cuid())
  walletId    String
  type        WalletTxnType
  amount      Decimal       @db.Decimal(10, 2)
  reason      String
  referenceId String? // payment / referral id

  createdAt DateTime @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([walletId])
}

/// Money going out of a wallet: the learner asks, an admin pays it and marks it
/// here. The balance is held the moment the request is made, and given back if
/// the request is turned down.
model WalletWithdrawal {
  id            String           @id @default(cuid())
  userId        String
  amount        Decimal          @db.Decimal(10, 2)
  status        WithdrawalStatus @default(PENDING)
  /// Where the learner wants it — a UPI id, or bank details, as they typed it.
  payoutNote    String?          @db.Text
  /// What the admin wrote when paying or refusing it.
  adminNote     String?          @db.Text
  processedById String?
  processedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User  @relation("WalletWithdrawalUser", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  processedBy User? @relation("WalletWithdrawalAdmin", fields: [processedById], references: [id], onUpdate: NoAction)

  @@index([userId])
  @@index([status])
}

model Referral {
  id           String         @id @default(cuid())
  referrerId   String
  refereeId    String?
  code         String
  status       ReferralStatus @default(PENDING)
  rewardAmount Decimal        @default(0) @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  referrer User  @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  referee  User? @relation("Referee", fields: [refereeId], references: [id], onUpdate: NoAction)

  @@index([referrerId])
  @@index([refereeId])
  @@index([code])
}

// ══════════════════════════════════════════════════════════════════════════════
// CURRICULUM
// ══════════════════════════════════════════════════════════════════════════════

/// A curriculum the academy publishes to its learners: what a course covers,
/// in the academy's own words, for a given year.
///
/// One curriculum can be set for several courses and several batches at once
/// ("I can select it is for which course, which batch. I can tick all also"),
/// and only learners on those courses or in those batches see it. `number` is
/// handed out once and never changes; `sequence` is the order they are listed
/// in, and can be rearranged.
model Curriculum {
  id          String  @id @default(cuid())
  number      Int     @default(0)
  sequence    Int     @default(0)
  /// "SFCMCCC001" — the academy prefix, the course's abbreviation, CC for
  /// curriculum, and this curriculum's number. Frozen for the same reason a
  /// batch's is.
  curriculumId String?
  title       String
  /// "2026", "2026-27" — whatever the academy writes on it.
  year        String?
  createdById String
  /// Off keeps it out of sight while it is being written.
  isPublished Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy User               @relation("CurriculumAuthor", fields: [createdById], references: [id], onUpdate: NoAction)
  tabs      CurriculumTab[]
  courses   CurriculumCourse[]
  batches   CurriculumBatch[]
  changes   CurriculumChange[]

  @@index([createdById])
}

/// One section of a curriculum — a heading and what sits under it.
model CurriculumTab {
  id           String  @id @default(cuid())
  curriculumId String
  heading      String
  description  String? @db.Text
  order        Int     @default(0)

  curriculum Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([curriculumId])
}

model CurriculumCourse {
  id           String @id @default(cuid())
  curriculumId String
  courseId     String

  curriculum Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  course     Course     @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([curriculumId])
  @@index([courseId])
}

model CurriculumBatch {
  id           String @id @default(cuid())
  curriculumId String
  batchId      String

  curriculum Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  batch      Batch      @relation(fields: [batchId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([curriculumId])
  @@index([batchId])
}

/// What changed, when, and who did it — "record of changes in the curriculum
/// should be maintained".
model CurriculumChange {
  id           String   @id @default(cuid())
  curriculumId String
  summary      String   @db.Text
  byId         String?
  createdAt    DateTime @default(now())

  curriculum Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  by         User?      @relation("CurriculumChangeAuthor", fields: [byId], references: [id], onUpdate: NoAction)

  @@index([curriculumId])
}

// ══════════════════════════════════════════════════════════════════════════════
// CERTIFICATES
// ══════════════════════════════════════════════════════════════════════════════

model Certificate {
  id               String            @id @default(cuid())
  userId           String
  /// Optional since not every award is about a course — an appreciation
  /// certificate recognises the learner, not a syllabus.
  courseId         String?
  enrollmentId     String?           @unique
  type             CertificateType   @default(COURSE_COMPLETION)
  serialNumber     String            @unique
  verificationCode String            @unique
  status           CertificateStatus @default(ISSUED)
  fileUrl          String?
  /// Per-design copy — batch name, internship dates, the citation. Shape is in
  /// `certificateDetailsSchema`.
  metadata         Json?
  issuedAt         DateTime          @default(now())

  createdAt DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  course     Course?     @relation(fields: [courseId], references: [id], onUpdate: NoAction)
  enrollment Enrollment? @relation(fields: [enrollmentId], references: [id], onUpdate: NoAction)

  /// One award of each kind per learner per course. A learner can hold a course
  /// completion *and* an appreciation for the same course, which the old
  /// two-column key forbade.
  @@unique([userId, courseId, type])
  @@index([courseId])
  @@index([type])
}

// ══════════════════════════════════════════════════════════════════════════════
// LIVE CLASSES / VIDEO CONFERENCING
// ══════════════════════════════════════════════════════════════════════════════

model Meeting {
  id                 String        @id @default(cuid())
  courseId           String?
  batchId            String?
  hostId             String
  title              String
  description        String?       @db.Text
  status             MeetingStatus @default(SCHEDULED)
  roomCode           String        @unique
  provider           String        @default("webrtc")
  location           String? // physical venue for offline classes
  scheduledStart     DateTime
  scheduledEnd       DateTime?
  actualStart        DateTime?
  actualEnd          DateTime?
  maxParticipants    Int?
  isRecordingEnabled Boolean       @default(false)
  recordingUrl       String?

  /// ── Recording playback control ─────────────────────────────────────────────
  /// "Recording jahan save hoti hai admin panel mein control hona chahiye —
  /// kaun kaun se student ko, kitne din ke liye recording dikhe, kitni baar
  /// dekh sakta hai, kitne devices mein dekh sakta hai." So the file the host's
  /// browser uploads is inert until staff publish it, and every allowance a
  /// learner gets is set here rather than assumed.

  /// Uploaded ≠ visible. A learner sees nothing until an admin publishes.
  recordingPublished Boolean @default(false)

  /// Stamped when `recordingPublished` first flips on — the clock that
  /// `recordingAvailableDays` counts from. Kept separate from `updatedAt` so
  /// editing any other field doesn't silently extend a learner's window.
  recordingPublishedAt DateTime?

  /// Days of access from publication. Null = no cut-off.
  recordingAvailableDays Int?

  /// A hard end date. When both are set this wins, because an admin who types
  /// a date means that date.
  recordingAvailableUntil DateTime?

  /// Watches allowed per learner, and distinct devices per learner.
  /// 0 = unlimited in both cases (the shipped behaviour before this existed).
  recordingViewLimit   Int @default(0)
  recordingDeviceLimit Int @default(0)

  /// Whether the player carries the drifting "Skill For Career" overlay.
  recordingWatermark Boolean @default(true)

  /// What a learner pays to have the overlay taken off this one recording.
  /// Null or 0 means it is not for sale, and no button is offered.
  watermarkRemovalPrice Decimal? @db.Decimal(10, 2)

  /// Created from the batch's timetable rather than by hand.
  autoScheduled  Boolean   @default(false)
  /// Someone moved, renamed or cancelled this auto class by hand, so rebuilding
  /// the timetable must leave it alone.
  manualOverride Boolean   @default(false)
  cancelReason   String?   @db.Text
  /// When the "your class is tomorrow, here is the link" email went out.
  reminderSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course       Course?              @relation(fields: [courseId], references: [id], onUpdate: NoAction)
  batch        Batch?               @relation(fields: [batchId], references: [id], onUpdate: NoAction)
  host         User                 @relation("MeetingHost", fields: [hostId], references: [id], onUpdate: NoAction)
  participants MeetingParticipant[]
  attendance   Attendance[]
  chatMessages LiveChatMessage[]

  recordingAccess  RecordingAccess[]
  recordingViews   RecordingView[]
  recordingDevices RecordingDevice[]
  boardSlides BoardSlide[]

  @@index([courseId])
  @@index([batchId])
  @@index([hostId])
  @@index([status])
}

model MeetingParticipant {
  id              String      @id @default(cuid())
  meetingId       String
  userId          String
  role            MeetingRole @default(ATTENDEE)
  joinedAt        DateTime?
  leftAt          DateTime?
  durationSeconds Int         @default(0)
  handRaised      Boolean     @default(false)

  createdAt DateTime @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([meetingId, userId])
  @@index([userId])
}

model LiveChatMessage {
  id        String @id @default(cuid())
  meetingId String
  userId    String
  message   String @db.Text

  createdAt DateTime @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([meetingId])
  @@index([userId])
}

model Attendance {
  id              String           @id @default(cuid())
  userId          String
  meetingId       String?
  batchId         String?
  status          AttendanceStatus @default(PRESENT)
  date            DateTime         @default(now())
  joinedAt        DateTime?
  leftAt          DateTime?
  durationSeconds Int              @default(0)

  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  meeting Meeting? @relation(fields: [meetingId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  batch   Batch?   @relation(fields: [batchId], references: [id], onUpdate: NoAction)

  @@unique([meetingId, userId])
  @@index([userId])
  @@index([meetingId])
  @@index([batchId])
}

// ══════════════════════════════════════════════════════════════════════════════
// CLASS RECORDINGS — who may watch, how often, on how many devices
// ══════════════════════════════════════════════════════════════════════════════

/// Who a published recording is open to. Exactly one of `batchId` / `userId` is
/// set on a row, and **no rows at all means everyone who could have attended
/// the class** — the same audience the live room itself lets in. That default
/// keeps every recording already in the database working untouched.
///
/// Like `LessonAccess`, the service replaces the whole set on each save
/// (deleteMany + createMany), so there is deliberately no unique index: a
/// duplicate cannot arise, and `db push` would demand a data-loss flag for one.
model RecordingAccess {
  id        String  @id @default(cuid())
  meetingId String
  batchId   String?
  userId    String?

  /// Per-row overrides of the meeting's window and watch cap, for the learner
  /// who missed the class and needs a fortnight longer than their cohort.
  /// Null = inherit the meeting's setting.
  expiresAt DateTime?
  viewLimit Int?

  createdAt DateTime @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  batch   Batch?  @relation(fields: [batchId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user    User?   @relation("RecordingAccessUser", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([meetingId])
  @@index([batchId])
  @@index([userId])
}

/// One learner's history with one recording: how many watches they have spent,
/// roughly how long they watched, and whether they have paid the watermark off.
///
/// `viewCount` is bumped by `INSERT … ON DUPLICATE KEY UPDATE` rather than a
/// Prisma upsert — see recording-service for why (an upsert is a SELECT then an
/// INSERT here, so two tabs opening together race for the same row).
model RecordingView {
  id        String @id @default(cuid())
  meetingId String
  userId    String

  viewCount      Int       @default(0)
  firstViewedAt  DateTime?
  lastViewedAt   DateTime?
  /// Best-effort: the player reports on pause, end and close, so a tab killed
  /// mid-playback loses its last stretch. Treat it as a hint, not a ledger.
  secondsWatched Int       @default(0)

  /// Set when this learner has bought the overlay off this one recording.
  watermarkWaivedAt  DateTime?
  watermarkPaymentId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user    User    @relation("RecordingViewUser", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([meetingId, userId])
  @@index([userId])
}

/// Devices a learner has watched a recording from. `deviceId` is a random id the
/// browser keeps for itself (localStorage, cookie fallback) — a deterrent that
/// makes "share your login with the whole batch" inconvenient, not DRM. Admins
/// can drop a row when a learner changes phone.
model RecordingDevice {
  id        String @id @default(cuid())
  meetingId String
  userId    String
  deviceId  String

  /// A short, human summary of the user agent — "Chrome on Android" — so the
  /// admin removing a device knows which one they are removing.
  label String?

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user    User    @relation("RecordingDeviceUser", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([meetingId, userId, deviceId])
  @@index([userId])
}

// ══════════════════════════════════════════════════════════════════════════════
// SYSTEM — notifications, activity logs, event outbox
// ══════════════════════════════════════════════════════════════════════════════

model Notification {
  id        String              @id @default(cuid())
  userId    String
  type      NotificationType    @default(SYSTEM)
  channel   NotificationChannel @default(IN_APP)
  title     String
  message   String              @db.Text
  data      Json?
  actionUrl String?
  isRead    Boolean             @default(false)
  readAt    DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, isRead])
  @@index([createdAt])
}

/// An announcement sent from the admin or instructor panel: "message broadcast
/// system … for some urgent changes and schedule change or any change".
///
/// Kept after sending so the academy can see what went out, to whom and when.
/// The bell notifications it produced are ordinary `Notification` rows; this is
/// the record of the send itself.
model Broadcast {
  id      String @id @default(cuid())
  title   String
  message String @db.Text
  /// Where the "Open" button in the notification and email points, if anywhere.
  actionUrl String?

  audience BroadcastAudience
  /// The ids the audience needs — role, batch, course or user ids. For
  /// placement candidates it holds the statuses picked instead. Empty = all.
  targetIds Json?

  /// The academy picked these per send: "Notification option for dashboard and
  /// email". At least one is always true.
  toDashboard Boolean @default(true)
  toEmail     Boolean @default(false)

  /// What actually happened, filled in once the send finishes.
  recipientCount Int @default(0)
  notifiedCount  Int @default(0)
  emailedCount   Int @default(0)

  sentById String
  createdAt DateTime @default(now())

  sentBy User @relation("BroadcastSender", fields: [sentById], references: [id], onUpdate: NoAction)

  @@index([sentById])
  @@index([createdAt])
}

/// The recycle bin: "Need a recycle bin for admin, student and instructor."
///
/// Deleting now takes a copy of the record and everything hanging off it before
/// the row goes, and `snapshot` is that copy. Restoring writes it back under its
/// original id, so anything that pointed at it still does.
///
/// A snapshot rather than a `deletedAt` flag on every table: a flag would mean
/// every query in the application has to remember to exclude the deleted, and
/// the one that forgets shows a learner something that was thrown away.
model TrashItem {
  id         String    @id @default(cuid())
  kind       TrashKind
  /// The id the record had. A restore puts it back under exactly this id.
  originalId String
  /// What it was called, and a line of context so two "Chapter 1" rows differ.
  title      String
  subtitle   String?
  /// The record and its children, as they were the moment before deletion.
  snapshot   Json

  deletedById String
  deletedAt   DateTime @default(now())

  deletedBy User @relation("TrashOwner", fields: [deletedById], references: [id], onUpdate: NoAction)

  @@index([kind])
  @@index([deletedById])
  @@index([deletedAt])
}

/// One word in the academy's dictionary.
///
/// "Terminology: which is like dictionary is required to upload every possible
/// meaning there and when anyone read notes, meaning of a word should be
/// visible by clicking on that word." So a term carries both a one-line meaning,
/// which is what a pop-up shows, and a fuller explanation for its own page.
///
/// `word` is not unique: the same spelling can be a root and an abbreviation,
/// and a lookup shows every sense rather than guessing one.
model Term {
  id          String   @id @default(cuid())
  word        String   @db.VarChar(120)
  /// `word` with case, punctuation and the slashes a dictionary uses stripped —
  /// "cardi/o" becomes "cardio". A learner clicks the word as it appears in the
  /// reading, which never carries those marks, so the lookup matches on this.
  wordKey     String   @default("") @db.VarChar(120)
  /// The same treatment for every synonym, joined and wrapped in bars
  /// ("|cardiac|heart|") so one `contains` finds an exact synonym.
  synonymKey  String?  @db.Text
  kind        TermKind @default(ROOT)
  /// Other words for the same thing, as a JSON array of strings. These are
  /// searched and looked up too, so a synonym finds the entry.
  synonyms    Json?
  /// The line a pop-up shows.
  meaning     String   @db.Text
  /// The fuller account, on the term's own page.
  explanation String?  @db.Text
  /// Worked examples, as a JSON array of strings.
  examples    Json?
  isPublished Boolean  @default(true)

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User           @relation("TermAuthor", fields: [createdById], references: [id], onUpdate: NoAction)
  bookmarks TermBookmark[]

  @@index([kind])
  @@index([word])
  @@index([wordKey])
  @@index([isPublished])
}

/// A word a learner saved — "an option to bookmark or save any word for later
/// studies".
model TermBookmark {
  id     String @id @default(cuid())
  userId String
  termId String

  createdAt DateTime @default(now())

  user User @relation("TermBookmarkUser", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  term Term @relation(fields: [termId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
  @@index([termId])
}

/// A page from the on-screen notepad an instructor writes on while teaching.
///
/// "An option of notepad to write like a board on screen with screen pen …
/// also an option to save those slides and filter those slides lecture wise or
/// class wise."
///
/// Strokes, not a picture: a page is kept as the lines that were drawn, in
/// coordinates from 0 to 1. So it reopens at any screen size, can be drawn on
/// further, and costs a few kilobytes rather than a megabyte of PNG.
model BoardSlide {
  id      String  @id @default(cuid())
  title   String
  /// The drawing: an array of strokes, each with its tool, colour, width and
  /// points. See `lib/validations/board.ts` for the shape.
  strokes Json
  /// What it was drawn for, which is what the filters work on.
  batchId   String?
  meetingId String?
  courseId  String?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  batch     Batch?   @relation(fields: [batchId], references: [id], onUpdate: NoAction)
  meeting   Meeting? @relation(fields: [meetingId], references: [id], onUpdate: NoAction)
  course    Course?  @relation(fields: [courseId], references: [id], onUpdate: NoAction)
  createdBy User     @relation("BoardAuthor", fields: [createdById], references: [id], onUpdate: NoAction)

  @@index([createdById])
  @@index([batchId])
  @@index([meetingId])
  @@index([courseId])
  @@index([createdAt])
}

model ActivityLog {
  id          String  @id @default(cuid())
  userId      String?
  action      String
  entityType  String?
  entityId    String?
  description String?
  ip          String?
  userAgent   String?
  metadata    Json?

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onUpdate: NoAction)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

/// Platform-wide configuration. A single "global" row holds the whole settings
/// object as JSON so new settings can be added without a schema migration; the
/// typed shape + validation lives in src/lib/validations/settings.ts.
model Setting {
  id          String   @id @default("global")
  data        Json
  updatedById String?
  updatedAt   DateTime @updatedAt
}

/// One editable band of the public homepage (hero, stats, testimonials, …).
///
/// The section's content lives in `data` as JSON rather than in columns or a
/// child table: the shape differs per section, most sections carry a repeatable
/// list, and the homepage is the busiest page on the site — one `findMany` has
/// to return everything it needs. `key` is the code-side identifier from
/// `src/lib/validations/homepage.ts`, which owns the schema and the defaults,
/// so a section that has never been edited still renders without a row here.
model HomeSection {
  key         String   @id
  enabled     Boolean  @default(true)
  order       Int      @default(0)
  data        Json
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([order])
}

/// Transactional outbox for the signed domain-event stream consumed by the
/// separate CRM product (see src/lib/events.ts). Rows are written in the same
/// transaction as the domain change, then delivered asynchronously.
model EventOutbox {
  id        String       @id @default(cuid())
  eventId   String       @unique
  type      String
  payload   Json
  signature String
  status    OutboxStatus @default(PENDING)
  attempts  Int          @default(0)
  sentAt    DateTime?

  createdAt DateTime @default(now())

  @@index([status])
  @@index([createdAt])
}

/// Uploaded bytes held in the database (STORAGE_DRIVER=db). Vercel's filesystem
/// is read-only apart from /tmp and is discarded between requests, so the
/// `local` driver cannot work there; keeping bytes here fixes uploads without
/// renting an object store. Served back by GET /api/files/<id><ext>, which sets
/// immutable cache headers so the CDN fetches each asset only once.
/// Large media (class recordings) belongs on S3 — see src/lib/storage.ts.
model MediaAsset {
  id        String   @id @default(cuid())
  mime      String
  ext       String
  /// The uploader's own filename, echoed back in the URL and Content-Disposition.
  name      String?
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ── Lead / CRM ────────────────────────────────────────────────────────────────

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST
}

/// The nine admissions stages from the client's status sheet. `Lead.subStatus`
/// carries the free-text sub-status that belongs to the stage (the catalogue
/// lives in src/lib/validations/lead.ts so counsellors' wording can change
/// without a migration).
enum LeadStage {
  FRESH_LEAD
  CONTACTED
  INTERESTED
  COUNSELLING_DEMO
  FOLLOW_UP
  ADMISSION_PENDING
  CONVERTED
  NOT_INTERESTED
  INVALID_LEAD
}

/// How a counsellor reached out to a lead from the CRM.
enum LeadContactChannel {
  CALL
  WHATSAPP
  SMS
}

/// Counsellor's read on how likely this lead is to convert.
enum LeadQuality {
  HOT
  WARM
  COLD
  NOT_SURE
}

/// How the learner wants to attend — asked at enquiry time so counsellors can
/// pitch the right batch.
enum LeadClassMode {
  ONLINE
  OFFLINE
  HYBRID
  RECORDED
  ANY
}

enum LeadSource {
  WEBSITE
  MANUAL
  REFERRAL
  PHONE
  WALK_IN
  SOCIAL
}

/**
 * A sales/admissions enquiry — from the website form, a manual entry or a CSV
 * import. The field list follows the client's counselling sheet: identity and
 * contact, what they want to study, where they are in the funnel
 * (stage + subStatus), their background, the centre visit being planned, and
 * the money on the table.
 */
model Lead {
  id       String   @id @default(cuid())
  /// Human-facing reference the counsellors quote — SFC1, SFC2, … Assigned by
  /// `nextLeadNo()`; unique so a racing insert loses rather than duplicates.
  leadNo   String?  @unique
  /// When the enquiry came in. Separate from createdAt because an imported or
  /// back-dated lead was received before the row existed.
  leadDate DateTime @default(now())

  name     String
  email    String?
  phone    String
  /// WhatsApp number when it differs from `phone`. Counsellors are routinely
  /// given a second number for messaging, and pinging the wrong one loses the
  /// lead — blank means "same as phone".
  whatsapp String?

  /// Picked from the course dropdown. `courseInterest` keeps the free text for
  /// website enquiries and imports that name a course we don't have a row for.
  courseId       String?
  courseInterest String?
  whyThisCourse  String? @db.Text

  source    LeadSource     @default(WEBSITE)
  /// Counsellor's read on the lead, and a 0-100 score for ranking the queue.
  quality   LeadQuality?
  leadScore Int?
  stage     LeadStage      @default(FRESH_LEAD)
  /// The academy's own stage, when it has defined its own.
  ///
  /// The nine built-in stages stay in `stage`, which every report and every
  /// automation reads. A stage the academy adds itself is written here and
  /// mapped onto whichever built-in it behaves like, so the pipeline keeps
  /// working while the names on screen are entirely theirs. Additive on
  /// purpose: turning the column itself into free text would mean an ALTER
  /// across every lead on file.
  stageKey  String?
  /// One of the stage's sub-statuses (see LEAD_SUB_STATUSES).
  subStatus String?
  status    LeadStatus     @default(NEW) // legacy — superseded by `stage`
  classMode LeadClassMode?

  // Background
  qualification String?
  jobStatus     String?
  experiencedIn String?
  address       String? @db.Text

  // Planned centre visit
  expectedVisit String?
  visitDate     DateTime?
  visitTime     String? // "16:30" — a wall-clock slot, not an instant

  /// The next scheduled call-back. Drives the counsellor's due list and the
  /// nightly reminder sweep, same as visitDate.
  followUpDate DateTime?
  followUpTime String?

  /// Counsellor's running notes (the website enquiry message lands here too).
  message String? @db.Text

  // Money
  feesOffered Decimal? @db.Decimal(10, 2)
  finalFees   Decimal? @db.Decimal(10, 2)
  emiCount    Int?

  assignedToId   String?
  /// Stamped by the email/SMS reminder so a sweep can't nag the same lead twice.
  lastRemindedAt DateTime?

  /// The learner account this lead became, set the first time a payment is
  /// collected. Keeps the CRM row and the student record joined up so the
  /// admissions team can answer "did this enquiry ever enrol?".
  convertedUserId String?
  convertedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course     Course?        @relation(fields: [courseId], references: [id], onUpdate: NoAction)
  assignedTo User?          @relation("LeadAssignee", fields: [assignedToId], references: [id], onUpdate: NoAction)
  followUps  LeadFollowUp[]
  documents  LeadDocument[]
  contacts   LeadContact[]
  payments   Payment[]      @relation("LeadPayments")

  convertedUser User? @relation("LeadConvertedStudent", fields: [convertedUserId], references: [id], onUpdate: NoAction)

  @@index([stage])
  @@index([quality])
  @@index([status])
  @@index([courseId])
  @@index([assignedToId])
  @@index([leadDate])
  @@index([visitDate])
  @@index([followUpDate])
  @@index([convertedUserId])
  @@index([createdAt])
}

/**
 * A time-stamped follow-up note against a lead (with optional stage snapshot).
 */
model LeadFollowUp {
  id               String      @id @default(cuid())
  leadId           String
  note             String      @db.Text
  stage            LeadStage?
  subStatus        String?
  status           LeadStatus? // legacy — superseded by `stage`
  createdById      String
  /// The next follow-up this remark scheduled, kept on the remark so the
  /// history shows what was promised when.
  nextFollowUpDate DateTime?
  nextFollowUpTime String?

  createdAt DateTime @default(now())

  lead      Lead @relation(fields: [leadId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  createdBy User @relation("LeadFollowUpAuthor", fields: [createdById], references: [id], onUpdate: NoAction)

  @@index([leadId])
  @@index([createdById])
}

/// One outreach attempt made from the CRM — who reached out, how, and when.
///
/// Written the moment a counsellor taps call / WhatsApp / SMS on a lead, before
/// the device handler takes over. The platform can't observe whether the call
/// connected, so this records the *attempt*: enough to see who is working their
/// queue and which leads have gone untouched.
model LeadContact {
  id      String             @id @default(cuid())
  leadId  String
  userId  String
  channel LeadContactChannel
  /// The number as dialled or messaged. Stored rather than joined because the
  /// lead's numbers can be edited afterwards and the history must not drift.
  target  String

  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user User @relation("LeadContactAgent", fields: [userId], references: [id], onUpdate: NoAction)

  @@index([leadId])
  @@index([userId])
  @@index([channel])
  @@index([createdAt])
}

/**
 * A document a counsellor attached to a lead — Aadhaar, marksheet, resume…
 */
model LeadDocument {
  id     String  @id @default(cuid())
  leadId String
  name   String
  url    String  @db.Text
  mime   String?
  size   Int?

  uploadedById String?
  createdAt    DateTime @default(now())

  lead       Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  uploadedBy User? @relation("LeadDocumentUploader", fields: [uploadedById], references: [id], onUpdate: NoAction)

  @@index([leadId])
  @@index([uploadedById])
}

// ── Webinars ──────────────────────────────────────────────────────────────────

/**
 * A public webinar/masterclass anyone can register for (not course-gated).
 */
model Webinar {
  id                        String   @id @default(cuid())
  title                     String
  slug                      String   @unique
  description               String?  @db.Text
  /// One-line subject, shown above the agenda on the public page.
  topic                     String?
  /// What will be covered, session by session.
  agenda                    String?  @db.Text
  hostName                  String
  hostId                    String?
  coverImageUrl             String?
  scheduledStart            DateTime
  durationMinutes           Int      @default(60)
  joinUrl                   String?
  /// Room code of the companion Meeting that backs "generate join link" — the
  /// uniqueness that matters lives on Meeting.roomCode, which this mirrors.
  roomCode                  String?
  capacity                  Int?
  /// Extra discount, in percent, for anyone who attends the whole session.
  attendanceDiscountPercent Int      @default(5)
  isPublished               Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  host          User?                 @relation("WebinarHost", fields: [hostId], references: [id], onUpdate: NoAction)
  registrations WebinarRegistration[]

  @@index([scheduledStart])
  @@index([isPublished])
  @@index([hostId])
  @@index([roomCode])
}

model WebinarRegistration {
  id           String  @id @default(cuid())
  webinarId    String
  name         String
  email        String
  phone        String?
  userId       String?
  /// True when staff added this participant by hand rather than them signing up.
  addedByStaff Boolean @default(false)

  // Attendance, filled in from the video room as people come and go.
  joinedAt        DateTime?
  leftAt          DateTime?
  attendedSeconds Int       @default(0)
  /// Set once watched time crosses the "whole session" threshold — this is what
  /// earns the extra discount.
  attendedFully   Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  webinar Webinar @relation(fields: [webinarId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user    User?   @relation("WebinarAttendee", fields: [userId], references: [id], onUpdate: NoAction)

  @@unique([webinarId, email])
  @@index([webinarId])
  @@index([userId])
}

/// One editable band of a secondary page — About, Contact, For Business or
/// Live Classes. Same shape and same machinery as `HomeSection`, kept in its own
/// table so the header and footer, which are read on *every* request, don't have
/// to page in the copy of four pages nobody is looking at.
model PageSection {
  key         String   @id
  enabled     Boolean  @default(true)
  order       Int      @default(0)
  data        Json
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([order])
}

// ══════════════════════════════════════════════════════════════════════════════
// MEDIA LIBRARY
// ══════════════════════════════════════════════════════════════════════════════

/// One catalogued upload.
///
/// `MediaAsset` above holds the *bytes* for the `db` storage driver only; this
/// is the driver-independent index the admin's Media page browses, so a file
/// uploaded to disk or to S3 is just as findable. Every upload through
/// `POST /api/upload` is recorded here, whatever it was uploaded for.
model MediaFile {
  id           String  @id @default(cuid())
  /// The public path the site uses — `/api/files/<id>/<name>`, or an S3 URL.
  url          String  @db.VarChar(512)
  /// The uploader's own filename, kept so the library is searchable by name.
  name         String
  mime         String
  size         Int
  /// Set for images, where known, so the picker can show dimensions.
  width        Int?
  height       Int?
  /// Free-text label an admin can add to find a file again later.
  alt          String?
  uploadedById String?

  createdAt DateTime @default(now())

  uploadedBy User? @relation("MediaUploader", fields: [uploadedById], references: [id], onUpdate: NoAction)

  @@index([createdAt])
  @@index([uploadedById])
  @@index([mime])
}

// ══════════════════════════════════════════════════════════════════════════════
// BLOG
// ══════════════════════════════════════════════════════════════════════════════

enum PostStatus {
  DRAFT
  PUBLISHED
}

model BlogPost {
  id              String     @id @default(cuid())
  /// Unique — see scripts/add-blog-slug-index.ts for why the index is created
  /// with raw DDL rather than by `db push`.
  slug            String     @unique @db.VarChar(191)
  title           String
  /// The card blurb and the meta description.
  excerpt         String?    @db.Text
  /// The body, as HTML from the editor.
  content         String     @db.LongText
  coverUrl        String?    @db.VarChar(512)
  status          PostStatus @default(DRAFT)
  /// Free tags, stored as a JSON array of strings.
  tags            Json?
  /// Optional catalogue category, so a post can sit beside the courses it is about.
  categoryId      String?
  authorId        String?
  /// Shown on the card and used for ordering; set the first time it is published.
  publishedAt     DateTime?
  readMinutes     Int        @default(3)
  views           Int        @default(0)
  /// Overrides for the page's <title> and description when set.
  metaTitle       String?
  metaDescription String?    @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category Category? @relation(fields: [categoryId], references: [id], onUpdate: NoAction)
  author   User?     @relation("BlogAuthor", fields: [authorId], references: [id], onUpdate: NoAction)

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([authorId])
}

// ══════════════════════════════════════════════════════════════════════════════
// ASSISTANT — the site chatbot ("Ami"), trained from the admin panel
// ══════════════════════════════════════════════════════════════════════════════

/// One thing the assistant knows how to answer.
///
/// The academy trains it by writing these rows — there is no rented model
/// behind it, in keeping with the plan's "no third party" rule. Matching is
/// keyword scoring over `question` + `patterns` (see lib/chatbot/match.ts), so
/// an answer is only ever the words staff typed.
model ChatIntent {
  id          String  @id @default(cuid())
  /// The canonical way a visitor asks this.
  question    String  @db.Text
  /// Other phrasings and keywords, as a JSON array of strings.
  patterns    Json?
  answer      String  @db.Text
  /// Optional button under the answer, e.g. "See courses" → /courses.
  actionLabel String?
  actionUrl   String? @db.VarChar(500)
  /// Grouping for the admin list ("Fees", "Placement", …).
  category    String?
  /// Offered as a starter chip when the window opens.
  isSuggested Boolean @default(false)
  isActive    Boolean @default(true)
  /// How often this answer has been served — the admin list sorts by it, so
  /// the academy can see what people actually ask.
  hits        Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages ChatMessage[]

  @@index([isActive])
  @@index([isSuggested])
}

/// A line of a conversation, kept so admins can read what was asked and teach
/// an answer to whatever went unmatched.
model ChatMessage {
  id        String  @id @default(cuid())
  sessionId String  @db.VarChar(64)
  userId    String?
  /// "user" or "bot".
  role      String  @db.VarChar(8)
  text      String  @db.Text
  intentId  String?
  /// False on a visitor question the assistant could not answer — the queue
  /// the admin "teach Ami" screen works through.
  matched   Boolean @default(true)
  /// Set once staff have turned this unanswered question into an intent.
  resolved  Boolean @default(false)

  createdAt DateTime @default(now())

  user   User?       @relation("ChatMessageUser", fields: [userId], references: [id], onUpdate: NoAction)
  intent ChatIntent? @relation(fields: [intentId], references: [id], onUpdate: NoAction)

  @@index([sessionId])
  @@index([userId])
  @@index([intentId])
  @@index([matched, resolved])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 9 (client list of 19 Sep 2026)
// ─────────────────────────────────────────────────────────────────────────────

/// Roles a person holds besides `User.roleId` — an instructor who is also a
/// student, a student who also teaches. Permissions are the union of all.
/// Uniqueness (user, role) is kept in code: a unique index needs a data-loss
/// flag on `db push`.
model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation("UserExtraRoles", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
  @@index([roleId])
}

/// Associate instructors on a batch, beside the lead `Batch.instructorId`.
model BatchInstructor {
  id        String   @id @default(cuid())
  batchId   String
  userId    String
  createdAt DateTime @default(now())

  batch Batch @relation(fields: [batchId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user  User  @relation("BatchAssociate", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([batchId])
  @@index([userId])
}

/// Notes and study material shared with a whole batch.
model BatchNote {
  id          String   @id @default(cuid())
  batchId     String
  title       String
  body        String?  @db.Text
  fileUrl     String?
  fileName    String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  batch       Batch        @relation(fields: [batchId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  createdBy   User         @relation("BatchNoteAuthor", fields: [createdById], references: [id], onUpdate: NoAction)
  quizSources QuizSource[]
  reads       NoteRead[]

  @@index([batchId])
  @@index([createdById])
}

/// How long a learner has actually spent with a note, and how often they came
/// back to it. One row per learner per note, added to as they read: the panel
/// reports reading time, and an instructor can see who has opened what.
///
/// Time is counted only while the note is open and the tab is in front, in
/// short heartbeats, so a note left open overnight cannot inflate it.
model NoteRead {
  id          String   @id @default(cuid())
  noteId      String
  userId      String
  opens       Int      @default(1)
  seconds     Int      @default(0)
  firstReadAt DateTime @default(now())
  lastReadAt  DateTime @default(now())

  note BatchNote @relation(fields: [noteId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user User      @relation("NoteReader", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([noteId, userId])
  @@index([userId])
}

/// A festival or holiday. On the day, wishes go to every student and
/// instructor; on a `noClasses` day the timetable skips that date.
model Holiday {
  id           String    @id @default(cuid())
  date         DateTime  @db.Date
  name         String
  message      String?   @db.Text
  noClasses    Boolean   @default(true)
  sendWishes   Boolean   @default(true)
  wishesSentAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([date])
}

enum ExperienceLevel {
  FRESHER
  EXPERIENCED
}

enum JobMode {
  ONSITE
  REMOTE
  HYBRID
  ANY
}

enum CandidateStatus {
  NEW
  SHORTLISTED
  REFERRED
  INTERVIEWING
  PLACED
  NOT_PLACED
  ON_HOLD
}

/// A CV sent through "Send your CV" on the careers page, and the candidate's
/// journey through placement afterwards.
model JobApplication {
  id                  String          @id @default(cuid())
  name                String
  email               String
  phone               String
  userId              String?
  courseId            String?
  courseName          String?
  /// The batch number printed on the certificate.
  batchCode           String?
  jobExpecting        String?
  experienceLevel     ExperienceLevel @default(FRESHER)
  experienceDetails   String?         @db.Text
  currentAddress      String?         @db.Text
  expectedLocation    String?
  expectedMode        JobMode?
  joiningAvailability String?
  cvUrl               String?
  cvName              String?
  status              CandidateStatus @default(NEW)
  placementPartnerId  String?
  hiringPartnerId     String?
  hiringPostId        String?
  placedAt            DateTime?
  placedCompany       String?
  placedRole          String?
  placedPackage       String?
  adminNotes          String?         @db.Text
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  placementPartner PlacementPartner? @relation(fields: [placementPartnerId], references: [id], onUpdate: NoAction)
  hiringPartner    HiringPartner?    @relation(fields: [hiringPartnerId], references: [id], onUpdate: NoAction)
  hiringPost       HiringPost?       @relation(fields: [hiringPostId], references: [id], onUpdate: NoAction)

  @@index([status])
  @@index([email])
  @@index([userId])
  @@index([placementPartnerId])
  @@index([hiringPartnerId])
  @@index([hiringPostId])
  @@index([createdAt])
}

/// A company that helps place our candidates.
model PlacementPartner {
  id            String   @id @default(cuid())
  name          String
  contactPerson String?
  email         String?
  phone         String?
  website       String?
  city          String?
  notes         String?  @db.Text
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  candidates JobApplication[]

  @@index([isActive])
}

/// A company that hires our candidates.
model HiringPartner {
  id            String   @id @default(cuid())
  name          String
  contactPerson String?
  email         String?
  phone         String?
  website       String?
  city          String?
  notes         String?  @db.Text
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  posts      HiringPost[]
  candidates JobApplication[]

  @@index([isActive])
}

/// A role a hiring partner is filling, for freshers or experienced people.
model HiringPost {
  id          String          @id @default(cuid())
  partnerId   String
  title       String
  level       ExperienceLevel @default(FRESHER)
  openings    Int?
  location    String?
  mode        JobMode?
  salary      String?
  description String?         @db.Text
  isOpen      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  partner    HiringPartner    @relation(fields: [partnerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  candidates JobApplication[]

  @@index([partnerId])
  @@index([isOpen])
}
