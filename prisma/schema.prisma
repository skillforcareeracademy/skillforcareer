  IN_PROGRESS
  COMPLETED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  EXPIRED
  REFUNDED
}

enum EnrollmentSource {
  PURCHASE
  FREE
  ADMIN_GRANT
  COUPON
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentProvider {
  RAZORPAY
  STRIPE
  WALLET
  MANUAL
}

enum PaymentType {
  ONE_TIME
  EMI
  SUBSCRIPTION
}

// How the learner actually paid — distinct from the gateway/provider.
