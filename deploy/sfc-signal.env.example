# Live-class signalling server config. Copy to /etc/sfc-signal.env and
# `chmod 600` it. DATABASE_URL and JWT_ACCESS_SECRET must match the values on
# Vercel exactly — the JWT secret is what verifies the room token the app mints,
# so a mismatch locks everyone out of the class. DATABASE_URL must point at the
# `lms` database (never TiDB's `sys` schema).
#
# The app points at this server through the Vercel env var
# SIGNAL_URL=https://media.skillforcareer.com (default is http://localhost:4001).
SIGNAL_PORT=4001
NODE_ENV=production
DATABASE_URL=mysql://user:pass@host:4000/lms
JWT_ACCESS_SECRET=
