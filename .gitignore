# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# locally-trusted dev certificates generated by `next dev --experimental-https`
/certificates

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# prisma generated client
/src/generated

# local file storage (uploads, recordings) — keep the folders, ignore contents
/storage/**
!/storage/
!/storage/uploads/
!/storage/uploads/.gitkeep
!/storage/recordings/
!/storage/recordings/.gitkeep

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local tooling notes
/.claude
/CLAUDE.md
/AGENTS.md
